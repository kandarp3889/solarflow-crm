PROJECT_NAME="True Sun Energy CRM SaaS"
VERSION="1.0.0"
API_V1_STR="/api"

# Generate a strong secret key for production:
SECRET_KEY="replace_with_a_secure_random_64_char_string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Neon Serverless PostgreSQL Connection string (Get free at https://neon.tech):
# Format: postgresql+psycopg://<user>:<password>@<neon-host>/<database>?sslmode=require
DATABASE_URL="postgresql+psycopg://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Allowed CORS origins (Include your Vercel frontend URL):
CORS_ORIGINS=["https://*.vercel.app","http://localhost:5173"]

# Optional SMTP Settings:
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="info.truesunenergy@gmail.com"
EMAILS_FROM_NAME="True Sun Energy"
